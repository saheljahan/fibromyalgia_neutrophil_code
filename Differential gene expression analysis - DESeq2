##########cases_NAR_vs_NNAR



/home/sjahan6/R-4.1.3/bin/R --no-save --quiet << EOF
library(DESeq2)
library("BiocParallel")
register(MulticoreParam(50))

C <- read.table( 
  "counts_case.txt", 
  sep="\t", header=TRUE, row.names=1, 
  as.is=TRUE, stringsAsFactors=FALSE )

coldata <- read.table( 
  "metadata_case.txt", 
  sep="\t", header=TRUE, row.names=1, 
  as.is=TRUE, stringsAsFactors=FALSE )
#
dds <- DESeqDataSetFromMatrix(
  countData=C,
  colData=coldata,
  design =~bmi + sex + age + NAS )

dds <- DESeq(
  dds,
  parallel=TRUE,
  BPPARAM=MulticoreParam(50) )
results <- results( dds)
coldata <- colData( dds )
#L   <- levels( coldata[["NAS"]] )
nC  <- as.data.frame( counts( dds, normalized=TRUE ) )
rmT <- rowMeans( nC[ , coldata[["NAS"]] == "NAR" ] )
rmB <- rowMeans( nC[ , coldata[["NAS"]] == "NNAR" ] )
rrr <- cbind( cbind( 
  as.data.frame( results( dds,contrast=c("NAS","NAR","NNAR"), independentFiltering=FALSE ) ), 
  rmT ), rmB )
colnames( rrr ) <- c( colnames( rrr )[ 1:6 ], "NAR", "NNAR" )
#=====----- results for all genes

O   <- order( rrr[["pvalue"]] )
rrr[ head( O ), ]
write.table( 
 rrr[ O, ],
  "neutrophil_case_NAR_vs_NNAR.DEG", 

 sep="\t",
 row.names=TRUE,
 col.names=TRUE,
 quote=FALSE )
EOF


