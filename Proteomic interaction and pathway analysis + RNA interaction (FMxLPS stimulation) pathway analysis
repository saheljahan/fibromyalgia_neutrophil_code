# -----------------------------------------------------------------------------
# Proteomics interaction analysis
# Model: log2 abundance ~ participant + stimulation + cohort:stimulation
# -----------------------------------------------------------------------------

ms <- read_excel(ms_input, sheet = ms_sheet)
protein_id <- as.character(ms[[1]])
mat <- as.matrix(ms[, -1])
storage.mode(mat) <- "numeric"

meta <- tibble(
  sample = colnames(mat),
  participant = sub("_.*$", "", sample),
  treatment = sub("^[^_]+_", "", sample),
  cohort = if_else(grepl("^HC", participant, ignore.case = TRUE), "HC", "FM")
)

fit_protein <- function(y, protein, stimulus, reference) {
  d <- meta %>%
    filter(treatment %in% c(reference, stimulus)) %>%
    mutate(abundance = as.numeric(y[match(sample, meta$sample)])) %>%
    select(participant, cohort, treatment, abundance) %>%
    pivot_wider(names_from = treatment, values_from = abundance) %>%
    filter(is.finite(.data[[reference]]), is.finite(.data[[stimulus]]))

  n_hc <- sum(d$cohort == "HC")
  n_fm <- sum(d$cohort == "FM")
  if (n_hc < 2 || n_fm < 2) return(NULL)

  model_data <- bind_rows(
    tibble(participant = d$participant, cohort = d$cohort,
           stimulation = 0, abundance = d[[reference]]),
    tibble(participant = d$participant, cohort = d$cohort,
           stimulation = 1, abundance = d[[stimulus]])
  ) %>%
    mutate(
      participant = factor(participant),
      cohort = factor(cohort, levels = c("HC", "FM")),
      fm_stim = stimulation * as.numeric(cohort == "FM")
    )

  X <- cbind(
    model.matrix(~ 0 + participant, data = model_data),
    stimulation = model_data$stimulation,
    fm_stim = model_data$fm_stim
  )

  fit <- lm.fit(X, model_data$abundance)
  if (fit$rank < ncol(X)) return(NULL)

  df_res <- length(model_data$abundance) - fit$rank
  if (df_res <= 0) return(NULL)

  s2 <- sum(fit$residuals^2) / df_res
  if (!is.finite(s2) || s2 <= 0) return(NULL)

  beta <- fit$coefficients
  hc_response <- beta["stimulation"]
  interaction <- beta["fm_stim"]
  fm_response <- hc_response + interaction

  v <- solve(crossprod(X))
  se_unscaled <- sqrt(v["fm_stim", "fm_stim"])
  ordinary_t <- interaction / (sqrt(s2) * se_unscaled)
  ordinary_p <- 2 * pt(-abs(ordinary_t), df = df_res)

  tibble(
    `Protein ID` = protein,
    Gene = protein,
    `HC response (log2)` = hc_response,
    `FM response (log2)` = fm_response,
    `Interaction FM-HC (log2)` = interaction,
    `Ordinary interaction t` = ordinary_t,
    `Ordinary interaction p` = ordinary_p,
    residual_variance = s2,
    residual_df = df_res,
    se_unscaled = se_unscaled,
    `n HC` = n_hc,
    `n FM` = n_fm,
    `n total` = n_hc + n_fm
  )
}

moderate_variances <- function(res) {
  valid <- with(res,
    is.finite(residual_variance) & residual_variance > 0 &
      is.finite(residual_df) & residual_df > 0
  )

  s2 <- res$residual_variance[valid]
  df <- res$residual_df[valid]
  e <- log(s2) - digamma(df / 2) + log(df / 2)
  evar <- var(e) - mean(trigamma(df / 2))

  df_prior <- if (is.finite(evar) && evar > 0) {
    uniroot(function(d0) trigamma(d0 / 2) - evar, c(0.01, 1e6))$root
  } else {
    1e6
  }

  prior_var <- exp(mean(e) + digamma(df_prior / 2) - log(df_prior / 2))
  post_var <- (df_prior * prior_var + df * s2) / (df_prior + df)

  res$posterior_variance <- NA_real_
  res$posterior_variance[valid] <- post_var
  res$`Moderated t` <- res$`Interaction FM-HC (log2)` /
    (sqrt(res$posterior_variance) * res$se_unscaled)
  res$`Moderated p` <- 2 * pt(
    -abs(res$`Moderated t`),
    df = res$residual_df + df_prior
  )
  res$`BH FDR` <- p.adjust(res$`Moderated p`, method = "BH")

  list(results = res, prior_df = df_prior, prior_variance = prior_var)
}

run_stimulus <- function(stimulus, reference) {
  message("Running ", stimulus, " vs ", reference)

  raw <- map_dfr(seq_len(nrow(mat)), ~
    fit_protein(mat[.x, ], protein_id[.x], stimulus, reference)
  )

  mod <- moderate_variances(raw)

  res <- mod$results %>%
    mutate(
      `Interaction ratio of ratios` = 2^`Interaction FM-HC (log2)`,
      `Interaction category` = case_when(
        `HC response (log2)` > 0 & `FM response (log2)` < 0 ~ "HC ↑ / FM ↓",
        `HC response (log2)` < 0 & `FM response (log2)` > 0 ~ "FM ↑ / HC ↓",
        abs(`HC response (log2)`) >= abs(`FM response (log2)`) ~ "Stronger in HC",
        TRUE ~ "Stronger in FM"
      ),
      `p < 0.05` = `Moderated p` < 0.05,
      `FDR < 0.05` = `BH FDR` < 0.05,
      `p < 0.05 & ≥1.3x` = `Moderated p` < 0.05 &
        abs(`Interaction FM-HC (log2)`) >= log2(1.3)
    ) %>%
    select(
      `Protein ID`, Gene, `Interaction category`,
      `HC response (log2)`, `FM response (log2)`,
      `Interaction FM-HC (log2)`, `Interaction ratio of ratios`,
      `Ordinary interaction t`, `Ordinary interaction p`,
      `Moderated t`, `Moderated p`, `BH FDR`,
      `p < 0.05`, `FDR < 0.05`, `p < 0.05 & ≥1.3x`,
      `n HC`, `n FM`, `n total`
    ) %>%
    arrange(`Moderated p`)

  cats <- c("HC ↑ / FM ↓", "FM ↑ / HC ↓", "Stronger in HC", "Stronger in FM")
  category_summary <- tibble(Category = cats) %>%
    mutate(
      `All proteins` = map_int(Category, ~ sum(res$`Interaction category` == .x)),
      `p<0.05` = map_int(Category, ~ sum(res$`Interaction category` == .x & res$`p < 0.05`))
    )

  list(
    stimulus = stimulus,
    reference = reference,
    results = res,
    category_summary = category_summary,
    prior_df = mod$prior_df,
    prior_variance = mod$prior_variance
  )
}

ms_runs <- map2(comparisons$stimulus, comparisons$reference, run_stimulus)
names(ms_runs) <- comparisons$stimulus

ms_summary <- map_dfr(ms_runs, function(x) {
  r <- x$results
  tibble(
    Stimulus = x$stimulus,
    Reference = x$reference,
    `Analyzable proteins` = nrow(r),
    `Nominal p<0.05` = sum(r$`p < 0.05`),
    `p<0.05 & >=1.3x` = sum(r$`p < 0.05 & ≥1.3x`),
    `FDR<0.05` = sum(r$`FDR < 0.05`),
    `HC up / FM down among p<0.05` = sum(r$`Interaction category` == "HC ↑ / FM ↓" & r$`p < 0.05`),
    `FM up / HC down among p<0.05` = sum(r$`Interaction category` == "FM ↑ / HC ↓" & r$`p < 0.05`),
    `Stronger HC among p<0.05` = sum(r$`Interaction category` == "Stronger in HC" & r$`p < 0.05`),
    `Stronger FM among p<0.05` = sum(r$`Interaction category` == "Stronger in FM" & r$`p < 0.05`),
    `Prior df` = x$prior_df,
    `Prior variance` = x$prior_variance
  )
})

write_ms_results <- function() {
  wb <- createWorkbook()
  title_style <- createStyle(fontSize = 14, textDecoration = "bold", fontColour = "#FFFFFF", fgFill = "#1F4E78")
  header_style <- createStyle(textDecoration = "bold", fontColour = "#FFFFFF", fgFill = "#4472C4", halign = "center", wrapText = TRUE)
  section_style <- createStyle(textDecoration = "bold", fontColour = "#FFFFFF", fgFill = "#5B9BD5", halign = "center")
  note_style <- createStyle(fontColour = "#444444", fgFill = "#EAF2F8", wrapText = TRUE)
  p_style <- createStyle(numFmt = "0.000E+00")
  num_style <- createStyle(numFmt = "0.000000")

  addWorksheet(wb, "Summary")
  writeData(wb, "Summary", "Cohort × stimulation interaction analysis", 1, 1)
  mergeCells(wb, "Summary", cols = 1:12, rows = 1)
  addStyle(wb, "Summary", title_style, rows = 1, cols = 1:12, gridExpand = TRUE)
  writeData(wb, "Summary", "Model", 3, 1)
  writeData(wb, "Summary", "log2 abundance ~ participant + stimulation + cohort:stimulation; participant is a fixed blocking factor. Empirical-Bayes moderation was applied to protein-wise residual variances.", 3, 2)
  mergeCells(wb, "Summary", cols = 2:12, rows = 3)
  addStyle(wb, "Summary", note_style, rows = 3, cols = 1:12, gridExpand = TRUE)
  writeData(wb, "Summary", ms_summary, 5, 1, headerStyle = header_style)
  setColWidths(wb, "Summary", cols = 1:12, widths = "auto")
  setColWidths(wb, "Summary", cols = 7:10, widths = 24)
  freezePane(wb, "Summary", firstActiveRow = 6)

  for (stim in names(ms_runs)) {
    x <- ms_runs[[stim]]
    r <- x$results

    addWorksheet(wb, stim)
    writeData(wb, stim, paste(stim, "cohort × stimulation interaction"), 1, 1)
    mergeCells(wb, stim, cols = 1:18, rows = 1)
    addStyle(wb, stim, title_style, rows = 1, cols = 1:18, gridExpand = TRUE)

    writeData(wb, stim, "Model note", 3, 1)
    writeData(wb, stim, "Paired model: log2 abundance ~ participant + stimulation + cohort:stimulation. The interaction coefficient is the FM-minus-HC difference in stimulation response.", 3, 2)
    mergeCells(wb, stim, cols = 2:18, rows = 3)
    addStyle(wb, stim, note_style, rows = 3, cols = 1:18, gridExpand = TRUE)

    writeData(wb, stim, x$category_summary, 5, 1, headerStyle = section_style)
    writeData(wb, stim, r, 11, 1, headerStyle = header_style)

    rows <- 12:(11 + nrow(r))
    addStyle(wb, stim, num_style, rows = rows, cols = c(4:8, 10), gridExpand = TRUE, stack = TRUE)
    addStyle(wb, stim, p_style, rows = rows, cols = c(9, 11, 12), gridExpand = TRUE, stack = TRUE)
    setColWidths(wb, stim, cols = 1:18, widths = "auto")
    setColWidths(wb, stim, cols = 3, widths = 20)
    setColWidths(wb, stim, cols = 4:15, widths = 18)
    freezePane(wb, stim, firstActiveRow = 12)
    addFilter(wb, stim, rows = 11, cols = 1:18)
  }

  saveWorkbook(wb, ms_results, overwrite = TRUE)
}

