go_df <- msigdbr(
  db_species = "HS",
  species = "Homo sapiens",
  collection = "C5",
  subcollection = "GO:BP"
)
go_bp <- lapply(split(go_df$gene_symbol, go_df$gs_name), unique)

clean_pathway <- function(x) {
  x %>%
    str_remove("^GOBP_") %>%
    str_replace_all("_", " ") %>%
    str_to_sentence()
}

format_fgsea <- function(res, stimulation = NULL, direction_labels = c("FM response > HC response", "HC response > FM response")) {
  res <- as.data.frame(res)
  res$leadingEdge <- vapply(res$leadingEdge, paste, collapse = "; ", FUN.VALUE = character(1))

  out <- res %>%
    mutate(
      pathway_clean = clean_pathway(pathway),
      Direction = case_when(
        NES > 0 ~ direction_labels[1],
        NES < 0 ~ direction_labels[2],
        TRUE ~ "No direction"
      ),
      Significant_FDR05 = padj < 0.05
    )

  if (!is.null(stimulation)) out <- mutate(out, Stimulation = stimulation)
  out
}

# -----------------------------------------------------------------------------
# Proteomics FGSEA
# -----------------------------------------------------------------------------

make_ms_ranks <- function(dat) {
  x <- dat %>%
    transmute(
      Gene = str_trim(str_extract(as.character(Gene), "^[^;]+")),
      stat = as.numeric(`Moderated t`)
    ) %>%
    filter(!is.na(Gene), Gene != "", is.finite(stat)) %>%
    group_by(Gene) %>%
    slice_max(abs(stat), n = 1, with_ties = FALSE) %>%
    ungroup()

  setNames(x$stat, x$Gene) %>% sort(decreasing = TRUE)
}

run_ms_fgsea <- function(stim) {
  dat <- read_excel(ms_results, sheet = stim, skip = 10)
  ranks <- make_ms_ranks(dat)

  fgseaMultilevel(go_bp, ranks, minSize = 15, maxSize = 500, eps = 0) %>%
    format_fgsea(stimulation = stim) %>%
    select(Stimulation, pathway, pathway_clean, Direction, size, ES, NES,
           pval, padj, log2err, Significant_FDR05, leadingEdge) %>%
    arrange(padj, desc(abs(NES)))
}

ms_fgsea_runs <- setNames(map(comparisons$stimulus, run_ms_fgsea), comparisons$stimulus)
ms_fgsea_fm <- map(ms_fgsea_runs, ~ filter(.x, NES > 0) %>% arrange(padj, desc(NES)))
ms_fgsea_hc <- map(ms_fgsea_runs, ~ filter(.x, NES < 0) %>% arrange(padj, NES))

ms_fgsea_summary <- map_dfr(comparisons$stimulus, function(stim) {
  x <- ms_fgsea_runs[[stim]]
  tibble(
    Stimulation = stim,
    `GO:BP tested` = nrow(x),
    `FDR < 0.05 total` = sum(x$padj < 0.05, na.rm = TRUE),
    `FDR < 0.05 toward FM` = sum(x$padj < 0.05 & x$NES > 0, na.rm = TRUE),
    `FDR < 0.05 toward HC` = sum(x$padj < 0.05 & x$NES < 0, na.rm = TRUE),
    `Nominal p < 0.05 toward FM` = sum(x$pval < 0.05 & x$NES > 0, na.rm = TRUE),
    `Nominal p < 0.05 toward HC` = sum(x$pval < 0.05 & x$NES < 0, na.rm = TRUE)
  )
})

write_fgsea_workbook <- function(file, summary, all, fm, hc) {
  wb <- createWorkbook()
  header <- createStyle(textDecoration = "bold", fgFill = "#D9EAF7", border = "Bottom")

  addWorksheet(wb, "Summary")
  writeData(wb, "Summary", summary)

  for (stim in names(all)) {
    sheets <- c(paste0(stim, "_ALL"), paste0(stim, "_FM"), paste0(stim, "_HC"))
    tabs <- list(all[[stim]], fm[[stim]], hc[[stim]])
    walk2(sheets, tabs, ~ {
      addWorksheet(wb, .x)
      writeData(wb, .x, .y)
    })
  }

  for (s in names(wb)) {
    n <- ncol(readWorkbook(wb, sheet = s))
    if (n > 0) {
      addStyle(wb, s, header, rows = 1, cols = 1:n, gridExpand = TRUE)
      setColWidths(wb, s, cols = 1:n, widths = "auto")
    }
    freezePane(wb, s, firstRow = TRUE)
  }

  saveWorkbook(wb, file, overwrite = TRUE)
}

