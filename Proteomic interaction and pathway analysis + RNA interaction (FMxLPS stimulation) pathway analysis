rna_plot_data <- map_dfr(c("HC_biased", "FM_biased"), function(s) {
  read_excel(rna_fgsea, sheet = s) %>%
    transmute(
      pathway_clean,
      padj = as.numeric(padj),
      NES = as.numeric(NES),
      Stimulation = "LPS",
      Group = if_else(s == "HC_biased", "HC-biased interaction", "FM-biased interaction")
    )
}) %>%
  mutate(
    Stimulation = factor(Stimulation, levels = "LPS"),
    Group = factor(Group, levels = c("HC-biased interaction", "FM-biased interaction"))
  )

ymax_rna <- 8
lps_col <- stim_cols["LPS"]
label_fill <- lighten_col(lps_col)

rna_plot_data <- rna_plot_data %>%
  filter(!is.na(pathway_clean), !is.na(padj), padj > 0) %>%
  mutate(significant = padj < 0.05, y = pmin(-log10(padj), ymax_rna)) %>%
  group_by(Group, Stimulation) %>%
  mutate(x = if (n() > 1) (sample.int(n()) - 1) / (n() - 1) else 0.5) %>%
  ungroup() %>%
  arrange(significant)

force_terms <- c(
  "Response to molecule of bacterial origin",
  "Cellular response to biotic stimulus",
  "Acute inflammatory response"
)

hc_labels <- rna_plot_data %>%
  filter(Group == "HC-biased interaction", pathway_clean %in% force_terms) %>%
  mutate(
    term_lab = str_wrap(pathway_clean, 22),
    label_x = case_when(
      pathway_clean == "Acute inflammatory response" ~ 0.20,
      pathway_clean == "Cellular response to biotic stimulus" ~ 0.50,
      pathway_clean == "Response to molecule of bacterial origin" ~ 0.80,
      TRUE ~ x
    ),
    label_y = case_when(
      pathway_clean == "Acute inflammatory response" ~ 5.2,
      pathway_clean == "Cellular response to biotic stimulus" ~ 6.2,
      pathway_clean == "Response to molecule of bacterial origin" ~ 7.2,
      TRUE ~ y + 1
    )
  )

fm_labels <- rna_plot_data %>%
  filter(Group == "FM-biased interaction", significant) %>%
  mutate(term_lab = format_label(pathway_clean, 20))

p_rna <- ggplot(rna_plot_data, aes(x, y)) +
  geom_hline(yintercept = -log10(0.05), linetype = "dashed", linewidth = 0.4, colour = "grey45") +
