lighten_col <- function(col, amount = 0.78) {
  rgb <- grDevices::col2rgb(col)
  rgb <- round(rgb + (255 - rgb) * amount)
  grDevices::rgb(rgb[1, ] / 255, rgb[2, ] / 255, rgb[3, ] / 255)
}

