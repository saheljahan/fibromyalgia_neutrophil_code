library(dplyr)
library(tableone)
library(coin)  # For exact Wilcoxon test
library(knitr)
library(DT)

filtered_phenos_FM$status <- factor(filtered_phenos_FM$status)
filtered_phenos_FM$si_gender <- factor(filtered_phenos_FM$si_gender, labels = c("Male", "Female"))

continuous_vars <- c("si_age", "ghs_bmi", "FMS_score", "FIQ_score", "SCL_somat_score", 
                     "BAI_score", "BDI_score", "PSQI_score", "PSS_score", "PPT")

create_median_table <- function(data, variables, group_var) {
  result <- data.frame(Variable = character(),
                       Group = character(),
                       N = integer(),
                       Median = numeric(),
                       IQR_Q1 = numeric(),
                       IQR_Q3 = numeric(),
                       P_value = numeric(),
                       stringsAsFactors = FALSE)
  
  groups <- levels(factor(data[[group_var]]))
  
  for (var in variables) {
    if (is.numeric(data[[var]])) {
      group_stats <- lapply(groups, function(g) {
        values <- data[[var]][data[[group_var]] == g]
        values <- values[!is.na(values)]
        n <- length(values)
        if (n > 0) {
          med <- median(values, na.rm = TRUE)
          q1 <- quantile(values, 0.25, na.rm = TRUE)
          q3 <- quantile(values, 0.75, na.rm = TRUE)
          return(list(n = n, median = med, q1 = q1, q3 = q3))
        } else {
          return(list(n = 0, median = NA, q1 = NA, q3 = NA))
        }
      })
      
      test_data <- data[!is.na(data[[var]]), c(var, group_var)]
      
      if (nrow(test_data) > 0 && length(unique(test_data[[group_var]])) > 1) {
        g1_data <- test_data[[var]][test_data[[group_var]] == groups[1]]
        g2_data <- test_data[[var]][test_data[[group_var]] == groups[2]]
        
        if (length(g1_data) * length(g2_data) < 10000) {
          wilcox_test_result <- try(wilcox.test(g1_data, g2_data, exact = TRUE), silent = TRUE)
        } else {
          wilcox_test_result <- try(wilcox.test(g1_data, g2_data, exact = FALSE), silent = TRUE)
        }
        
        if (!inherits(wilcox_test_result, "try-error")) {
          p_value <- wilcox_test_result$p.value
          
          if (p_value == 0) {
            wilcox_exact <- try(wilcox_test(as.formula(paste(var, "~", group_var)), 
                                            data = test_data,
                                            distribution = "exact"), silent = TRUE)
            if (!inherits(wilcox_exact, "try-error")) {
              p_value <- pvalue(wilcox_exact)
            }
          }
        } else {
          p_value <- NA
        }
      } else {
        p_value <- NA
      }
      
      for (i in seq_along(groups)) {
        result <- rbind(result, data.frame(
          Variable = var,
          Group = groups[i],
          N = group_stats[[i]]$n,
          Median = group_stats[[i]]$median,
          IQR_Q1 = group_stats[[i]]$q1,
          IQR_Q3 = group_stats[[i]]$q3,
          P_value = if (i == 1) p_value else NA,
          stringsAsFactors = FALSE
        ))
      }
    }
  }
  
  return(result)
}

