# Function to test association
test_assoc <- function(var, group) {
  if (is.numeric(var)) {
    # Wilcoxon rank-sum test for numeric variables
    test <- wilcox.test(var ~ group)
    return(c("numeric", test$statistic, test$p.value))
  } else {
    # Fisher's Exact test for categorical variables
    test <- fisher.test(table(var, group))
    return(c("categorical", NA, test$p.value))
  }
}

