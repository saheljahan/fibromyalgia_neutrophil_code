# Function to calculate descriptive statistics for continuous variables
calc_continuous_stats <- function(x) {
  x <- x[!is.na(x)]  # Remove NA values
  if(length(x) == 0) {
    return(c(n = 0, mean = NA, median = NA, sd = NA, min = NA, max = NA))
  }
  c(n = length(x),
    mean = mean(x),
    median = median(x),
    sd = sd(x),
    min = min(x),
    max = max(x))
}

# Function to calculate descriptive statistics for categorical variables
calc_categorical_stats <- function(x, var_name) {
  tab <- table(x, useNA = "ifany")
  n_total <- length(x)
  
  # Create a formatted string with counts and percentages
  result <- paste0(names(tab), ": ", tab, " (", 
                   round(100 * tab / n_total, 1), "%)", 
                   collapse = "; ")
  
  return(data.frame(
    variable = var_name,
    n_total = n_total,
    distribution = result,
    stringsAsFactors = FALSE
  ))
}

# Initialize results data frame for continuous variables
continuous_results <- data.frame()

# Process continuous variables
for (var in continuous_vars) {
  if (var %in% names(data)) {
    
    # Get the numeric data
    var_data <- data[[var]]
    
    # Overall statistics
    overall_stats <- calc_continuous_stats(var_data)
    
    # Cases statistics - use logical indexing properly
    cases_indices <- !is.na(data$cond) & data$cond == "Case"
    cases_data <- var_data[cases_indices]
    cases_stats <- calc_continuous_stats(cases_data)
    
    # Controls statistics - use logical indexing properly  
    controls_indices <- !is.na(data$cond) & data$cond == "Control"
    controls_data <- var_data[controls_indices]
    controls_stats <- calc_continuous_stats(controls_data)
    
    # Wilcoxon rank-sum test
    cases_values <- cases_data[!is.na(cases_data)]
    controls_values <- controls_data[!is.na(controls_data)]
    
    if (length(cases_values) > 0 && length(controls_values) > 0) {
      tryCatch({
        wilcox_test <- wilcox.test(cases_values, controls_values)
        p_value <- wilcox_test$p.value
      }, error = function(e) {
        cat("Error in Wilcoxon test for", var, ":", e$message, "\n")
        p_value <<- NA
      })
    } else {
      p_value <- NA
    }
    
    # Combine results
    row_result <- data.frame(
      Variable = var,
      
      # Combined statistics
      Combined_N = overall_stats["n"],
      Combined_Mean = round(overall_stats["mean"], 2),
      Combined_Median = round(overall_stats["median"], 2),
      Combined_SD = round(overall_stats["sd"], 2),
      Combined_Min = round(overall_stats["min"], 2),
      Combined_Max = round(overall_stats["max"], 2),
      
      # Cases statistics
      Cases_N = cases_stats["n"],
      Cases_Mean = round(cases_stats["mean"], 2),
      Cases_Median = round(cases_stats["median"], 2),
      Cases_SD = round(cases_stats["sd"], 2),
      Cases_Min = round(cases_stats["min"], 2),
      Cases_Max = round(cases_stats["max"], 2),
      
      # Controls statistics
      Controls_N = controls_stats["n"],
      Controls_Mean = round(controls_stats["mean"], 2),
      Controls_Median = round(controls_stats["median"], 2),
      Controls_SD = round(controls_stats["sd"], 2),
      Controls_Min = round(controls_stats["min"], 2),
      Controls_Max = round(controls_stats["max"], 2),
      
      # Test results
      P_value = ifelse(is.na(p_value), "NA", 
                       ifelse(p_value < 0.001, "<0.001", round(p_value, 3))),
      Test = "Wilcoxon rank-sum"
    )
    
    continuous_results <- rbind(continuous_results, row_result)
  }
}

# Initialize results data frame for categorical variables
categorical_results <- data.frame()

# Process categorical variables
for (var in categorical_vars) {
  if (var %in% names(data)) {
    
    # Clean the categorical data
    var_data <- as.character(data[[var]])
    var_data[var_data == "NA" | var_data == "" | is.na(var_data)] <- NA
    
    # Create contingency table with proper indexing
    cond_data <- data$cond
    
    # Remove rows where either variable is NA for the contingency table
    valid_indices <- !is.na(var_data) & !is.na(cond_data)
    cont_table <- table(var_data[valid_indices], cond_data[valid_indices])
    
    # Chi-square test
    tryCatch({
      if (all(dim(cont_table) >= 2) && all(cont_table >= 5) && sum(cont_table) > 0) {
        chi_test <- chisq.test(cont_table)
        p_value <- chi_test$p.value
        test_type <- "Chi-square"
      } else {
        # Use Fisher's exact test for small samples
        fisher_test <- fisher.test(cont_table)
        p_value <- fisher_test$p.value
        test_type <- "Fisher's exact"
      }
    }, error = function(e) {
      cat("Error in test for", var, ":", e$message, "\n")
      p_value <<- NA
      test_type <<- "Test failed"
    })
    
    # Calculate statistics for each group
    overall_stats <- calc_categorical_stats(var_data, var)
    cases_indices <- !is.na(data$cond) & data$cond == "Case"
    controls_indices <- !is.na(data$cond) & data$cond == "Control"
    cases_stats <- calc_categorical_stats(var_data[cases_indices], var)
    controls_stats <- calc_categorical_stats(var_data[controls_indices], var)
    
    # Combine results
    row_result <- data.frame(
      Variable = var,
      Combined_Distribution = overall_stats$distribution,
      Combined_N = overall_stats$n_total,
      Cases_Distribution = cases_stats$distribution,
      Cases_N = cases_stats$n_total,
      Controls_Distribution = controls_stats$distribution,
      Controls_N = controls_stats$n_total,
      P_value = ifelse(p_value < 0.001, "<0.001", round(p_value, 3)),
      Test = test_type
    )
    
    categorical_results <- rbind(categorical_results, row_result)
  }
}

