# ---- helper to compute correlations vs PGIC ----
corr_with_pgic <- function(df, y = "PGIC") {
  stopifnot(y %in% names(df))
  yv <- df[[y]]
  
  # numeric variables (except PGIC)
  num_vars <- names(df)[sapply(df, is.numeric) & names(df) != y]
  
  res_num <- map_dfr(num_vars, function(v) {
    x <- df[[v]]
    keep <- complete.cases(x, yv)
    if (sum(keep) < 3) {
      tibble(variable = v, n = sum(keep), method = "Spearman",
             rho = NA_real_, p = NA_real_)
    } else {
      ct <- suppressWarnings(cor.test(x[keep], yv[keep],
                                      method = "spearman", exact = FALSE))
      tibble(variable = v, n = sum(keep), method = "Spearman",
             rho = unname(ct$estimate), p = ct$p.value)
    }
  })
  
  # binary categorical variables (character/factor with 2 levels)
  fac_vars <- names(df)[sapply(df, function(z) is.factor(z) || is.character(z))]
  fac_vars <- setdiff(fac_vars, y)
  
  res_fac <- map_dfr(fac_vars, function(v) {
    f <- df[[v]]
    if (is.character(f)) f <- factor(f)
    if (!is.factor(f) || length(levels(f)) != 2) return(NULL)
    lv <- levels(f)
    x <- as.integer(f == lv[2])     # encode as 0/1
    keep <- complete.cases(x, yv)
    if (sum(keep) < 3) {
      tibble(variable = v, n = sum(keep), method = "Spearman (binary)",
             rho = NA_real_, p = NA_real_, reference = lv[1], compared_to = lv[2])
    } else {
      ct <- suppressWarnings(cor.test(x[keep], yv[keep],
                                      method = "spearman", exact = FALSE))
      tibble(variable = v, n = sum(keep), method = "Spearman (binary)",
             rho = unname(ct$estimate), p = ct$p.value,
             reference = lv[1], compared_to = lv[2])
    }
  })
  
  bind_rows(res_num, res_fac) %>%
    mutate(direction = case_when(
      is.na(rho) ~ NA_character_,
      rho > 0 ~ "positive",
      rho < 0 ~ "negative",
      TRUE ~ "zero"
    )) %>%
    arrange(p)
}

