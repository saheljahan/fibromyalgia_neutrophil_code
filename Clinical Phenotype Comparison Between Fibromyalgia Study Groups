data$cond <- as.character(data$cond)
data$cond <- trimws(data$cond)  # Remove any whitespace

# Check the grouping variable
cat("Unique values in cond variable:", unique(data$cond), "\n")
cat("Number of cases:", sum(data$cond == "Case", na.rm = TRUE), "\n")
cat("Number of controls:", sum(data$cond == "Control", na.rm = TRUE), "\n")

# Clean and convert all continuous variables to numeric
# Handle "NA" strings and other non-numeric values
continuous_vars_to_clean <- c("age", "bmi", "si_age", "FMS_score", "FIQ_score", 
                              "SCL_somat_score", "BAI_score", "BDI_score", 
                              "PSQI_score", "PSS_score", "PPT")

for (var in continuous_vars_to_clean) {
  if (var %in% names(data)) {
    # Convert to character first to handle any factor issues
    data[[var]] <- as.character(data[[var]])
    # Replace "NA" strings with actual NA, then convert to numeric
    data[[var]] <- as.numeric(ifelse(data[[var]] == "NA" | data[[var]] == "", NA, data[[var]]))
  }
}

# Define continuous and categorical variables
continuous_vars <- c("age", "bmi", "si_age", "FMS_score", "FIQ_score", 
