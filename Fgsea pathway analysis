R --no-save --quiet << EOF
library(fgsea)
library(parallel)
# library(ggplot2)

  rrr <- read.table( "neutrophils_cases_NAR_vs_NNAR.txt",
   sep="\t", header=TRUE, as.is=TRUE, stringsAsFactors=FALSE )
  O   <- order( -rrr[,"stat"] )
  rrr <- rrr[ O, ]
# R   <- which( ( rrr[["baseMean"]] >= 10 ) & ( ! is.na( rrr[["padj"]] ) ) )
  R   <- which( ! is.na( rrr[["padj"]] ) )
  rankedv        <- as.vector( rrr[["stat"]][R] )
  names(rankedv) <- rownames( rrr[R,] )
  if( length( grep( "gene", colnames( rrr ) ) ) == 1 )
     names(rankedv) <- rrr[R,"gene"]


# desc <- read.table( "/scratch/mparis15/PATHWAY/pathway_desc_GV4.txt",
# desc <- read.table( "/scratch/mparis15/PATHWAY/pathway_desc_neuroinflam.txt",
# contains all three CC, BP and MF:
# desc <- read.table( "/scratch/mparis15/PATHWAY/pathway_desc.txt",
# desc <- read.table( "/home/mparis15/GENOME/PharmGKB/pathway_desc.txt",
# desc <- read.table( "/scratch/mparis15/PATHWAY_2019dec/pathway_desc_${aDB}.txt",
  desc <- read.table( "/home/sjahan6/pathway/pathway_july_2022/Human_GOBP_desc.txt",
 quote="",
 sep="\t", header=FALSE,
 as.is=TRUE, stringsAsFactors=FALSE,
 colClasses=c("character","character"))
colnames( desc ) <- c("pathway","desc")


# goBP <- gmtPathways("/home/mparis15/AcutePain/pathways_GOBP_GV4.gmt")
# goBP <- gmtPathways("/home/mparis15/AcutePain/pathways_GOBP_neuroinflam.gmt")
# goBP <- gmtPathways("/home/mparis15/AcutePain/pathways_GOMF.gmt")
# goBP <- gmtPathways("/home/mparis15/AcutePain/pathways_GOCC.gmt")
# goBP <- gmtPathways("/home/mparis15/AcutePain/pathways_GOBP.gmt")
# goBP <- gmtPathways("/home/mparis15/GENOME/PharmGKB/PharmGKB.gmt")
  goBP <- gmtPathways("/home/sjahan6/pathway/pathway_july_2022/Human_GOBP_fgsea.gmt")
# select ONLY THAT GO
# if( nchar( "GOBP" ) > 0 ){ goBP <- list( \`GOBP\`=goBP[[ "GOBP" ]] ) }

set.seed( 666 )
gsea_goBP <- fgsea(
  pathways = goBP,
  stats    = rankedv,
  minSize  = 1,
  maxSize  = 1000,
  nperm    = 1e7,
  nproc    = ceiling( detectCores() / 2 ) )

gsea_goBP <- merge( desc, gsea_goBP, by.x="pathway", by.y="pathway" )
O <- order( gsea_goBP[[ "pval" ]] )

gsea_goBP[[ "leadingEdge" ]] <-
 sapply( gsea_goBP[[ "leadingEdge" ]],
        FUN = paste, collapse = "," )

write.table( gsea_goBP[ head( O ), ], sep="\t",
  row.names=FALSE, col.names=TRUE, quote=FALSE )


# specific pathways dumped on screen
# if( nchar( "GOBP" ) == 0 ) {
write.table( gsea_goBP[ O, ],
# "fgsea_neutrophil_case_NAR_vs_NNAR.GO.txt",
  "fgsea_neutrophil_case_NAR_vs_NNAR.GOBP.txt",
  sep="\t",
  row.names=FALSE,
  col.names=TRUE,
  quote=FALSE )
# }
EOF
